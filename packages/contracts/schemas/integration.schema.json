{
  "$defs": {
    "Action": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "effect": {
          "enum": [
            "read",
            "write"
          ],
          "title": "Effect",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{1,40}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "params": {
          "additionalProperties": {
            "$ref": "#/$defs/Param"
          },
          "maxProperties": 20,
          "title": "Params",
          "type": "object"
        },
        "request": {
          "$ref": "#/$defs/Request"
        },
        "response": {
          "$ref": "#/$defs/Response"
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "effect",
        "request",
        "response"
      ],
      "title": "Action",
      "type": "object"
    },
    "Auth": {
      "additionalProperties": false,
      "description": "How a person signs in. `oauth` and `api_key` use the person's own connected account.",
      "properties": {
        "mode": {
          "enum": [
            "none",
            "oauth",
            "api_key"
          ],
          "title": "Mode",
          "type": "string"
        },
        "provider": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9-]{1,62}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "scopes": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Scopes",
          "type": "array"
        }
      },
      "required": [
        "mode"
      ],
      "title": "Auth",
      "type": "object"
    },
    "Output": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "path": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "type": {
          "enum": [
            "string",
            "integer",
            "number",
            "boolean",
            "array",
            "object"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "path",
        "type",
        "description"
      ],
      "title": "Output",
      "type": "object"
    },
    "Param": {
      "additionalProperties": false,
      "properties": {
        "default": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default"
        },
        "description": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "enum": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 30,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Enum"
        },
        "fill": {
          "default": "user_or_model",
          "enum": [
            "user",
            "model",
            "user_or_model"
          ],
          "title": "Fill",
          "type": "string"
        },
        "max_length": {
          "default": 500,
          "maximum": 5000,
          "minimum": 1,
          "title": "Max Length",
          "type": "integer"
        },
        "maximum": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum"
        },
        "minimum": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "type": {
          "enum": [
            "string",
            "integer",
            "boolean",
            "object"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "description"
      ],
      "title": "Param",
      "type": "object"
    },
    "Request": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Body"
        },
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "maxProperties": 10,
          "title": "Headers",
          "type": "object"
        },
        "method": {
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ],
          "title": "Method",
          "type": "string"
        },
        "query": {
          "additionalProperties": {
            "type": "string"
          },
          "maxProperties": 20,
          "title": "Query",
          "type": "object"
        },
        "url": {
          "maxLength": 500,
          "minLength": 10,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "method",
        "url"
      ],
      "title": "Request",
      "type": "object"
    },
    "Response": {
      "additionalProperties": false,
      "properties": {
        "outputs": {
          "additionalProperties": {
            "$ref": "#/$defs/Output"
          },
          "maxProperties": 20,
          "minProperties": 1,
          "title": "Outputs",
          "type": "object"
        }
      },
      "required": [
        "outputs"
      ],
      "title": "Response",
      "type": "object"
    }
  },
  "$id": "https://nortpole.local/contracts/integration.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actions": {
      "items": {
        "$ref": "#/$defs/Action"
      },
      "maxItems": 30,
      "minItems": 1,
      "title": "Actions",
      "type": "array"
    },
    "auth": {
      "$ref": "#/$defs/Auth"
    },
    "category": {
      "title": "Category",
      "type": "string"
    },
    "data_classes": {
      "items": {
        "enum": [
          "public",
          "internal",
          "confidential",
          "restricted"
        ],
        "type": "string"
      },
      "minItems": 1,
      "title": "Data Classes",
      "type": "array"
    },
    "description": {
      "maxLength": 300,
      "minLength": 1,
      "title": "Description",
      "type": "string"
    },
    "group": {
      "enum": [
        "horizontal",
        "vertical"
      ],
      "title": "Group",
      "type": "string"
    },
    "hosts": {
      "items": {
        "type": "string"
      },
      "maxItems": 10,
      "minItems": 1,
      "title": "Hosts",
      "type": "array"
    },
    "id": {
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}$",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "enum": [
        "connector",
        "plugin"
      ],
      "title": "Kind",
      "type": "string"
    },
    "name": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "policy_default": {
      "default": "needs_approval",
      "enum": [
        "allowed",
        "needs_approval"
      ],
      "title": "Policy Default",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "version": {
      "pattern": "^\\d{1,4}\\.\\d{1,4}\\.\\d{1,4}$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "id",
    "name",
    "version",
    "description",
    "kind",
    "group",
    "category",
    "auth",
    "hosts",
    "data_classes",
    "actions"
  ],
  "title": "Integration",
  "type": "object"
}
